{
  "expo": {
    "name": "EnviroSync",
    "slug": "envirosync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/EnviroSync_logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "envirosync",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A84FF",
        "foregroundImage": "./assets/EnviroSync_logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.envirosync.app"
    },
    "web": {
      "favicon": "./assets/EnviroSync_logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "envirosync-smart-indoor"
      }
    }
  }
}
